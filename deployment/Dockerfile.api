# ICare API + inference engine (CPU). Built by compose.yaml, or directly:
#   docker build -f deployment/Dockerfile.api -t icare-api .
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ICARE_POSEC3D_MODEL=/app/models/posec3d_fall.onnx
WORKDIR /app

# Pinned runtime with a single (headless) OpenCV; see requirements-runtime.txt.
COPY deployment/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN pip install -r /tmp/requirements-runtime.txt && rm /tmp/requirements-runtime.txt

COPY pyproject.toml ./
COPY src/icare ./src/icare
RUN pip install --no-deps -e .
COPY models ./models
COPY examples ./examples

# Both ONNX models are in the image. Load and verify the whole engine (hashes,
# interfaces, one forward pass each) so a broken model fails the build instead
# of the first visitor. No network access is needed here or at startup.
RUN python -c "from icare.inference.engine import load_engine; load_engine({'model_path': '$ICARE_POSEC3D_MODEL', 'device': 'cpu'}).close()"

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin icare \
    && mkdir -p /app/artifacts \
    && chown -R icare:icare /app/artifacts
USER icare
EXPOSE 8000
# The API is reachable only from the web (nginx) container, which overwrites
# X-Forwarded-For with the real peer address; see deployment/nginx.conf.
CMD ["python", "-m", "uvicorn", "icare.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
