# ICare API + inference engine (CPU). Built by compose.yaml, or directly:
#   docker build -f deployment/Dockerfile.api -t icare-api .
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ICARE_POSEC3D_MODEL=/app/models/posec3d_fall.onnx \
    ICARE_POSE_MODEL=/app/models/yolo26n-pose.onnx
WORKDIR /app

# Both models run from the local models/ directory, with one headless OpenCV.
COPY deployment/requirements-runtime.txt /tmp/deps/
RUN pip install -r /tmp/deps/requirements-runtime.txt \
 && rm -rf /tmp/deps

COPY pyproject.toml ./
COPY src/icare ./src/icare
RUN pip install --no-deps -e .
COPY models ./models
COPY examples ./examples

# 1 (default): verify both local models at build time. 0 skips the build-time
# forward pass; startup always validates both models before reporting ready.
ARG PRELOAD_MODELS=1
RUN if [ "$PRELOAD_MODELS" = "1" ]; then \
      python -c "from icare.inference.engine import load_engine; load_engine({'model_path': '$ICARE_POSEC3D_MODEL', 'device': 'cpu'}).close()"; \
    fi

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin icare \
    && mkdir -p /app/artifacts \
    && chown -R icare:icare /app/artifacts
USER icare
EXPOSE 8000
# The API is reachable only from the web (nginx) container, which overwrites
# X-Forwarded-For with the real peer address; see deployment/nginx.conf.
CMD ["python", "-m", "uvicorn", "icare.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
