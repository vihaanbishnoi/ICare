# ICare API + inference engine (CPU). Built by compose.yaml, or directly:
#   docker build -f deployment/Dockerfile.api -t icare-api .
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # rtmlib caches YOLOX/RTMPose weights under $TORCH_HOME/hub/checkpoints.
    TORCH_HOME=/opt/icare/model-cache \
    ICARE_POSEC3D_MODEL=/app/models/posec3d_fall.onnx
WORKDIR /app

# One OpenCV only (headless). rtmlib is installed --no-deps so its metadata
# cannot add opencv-python/opencv-contrib-python beside it; see the comments
# in deployment/requirements-runtime.txt.
COPY deployment/requirements-runtime.txt deployment/rtmlib.txt /tmp/deps/
RUN pip install -r /tmp/deps/requirements-runtime.txt \
 && pip install --no-deps -r /tmp/deps/rtmlib.txt \
 && rm -rf /tmp/deps

COPY icare_app ./icare_app
COPY api ./api
COPY models ./models
COPY examples ./examples

# 1 (default): download the pose weights and load the full engine once at build
# time, so the container starts ready without network access and a broken model
# fails the build instead of the first visitor. 0: skip (CI); /ready then needs
# the host to reach the model URLs in icare_app/pose.py at startup.
ARG PRELOAD_MODELS=1
RUN mkdir -p "$TORCH_HOME" \
 && if [ "$PRELOAD_MODELS" = "1" ]; then \
      python -c "from icare_app.engine import load_engine; load_engine({'model_path': '$ICARE_POSEC3D_MODEL', 'device': 'cpu'}).close()"; \
    fi

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin icare \
    && mkdir -p /app/artifacts \
    && chown -R icare:icare /app/artifacts "$TORCH_HOME"
USER icare
EXPOSE 8000
# The API is reachable only from the web (nginx) container, which overwrites
# X-Forwarded-For with the real peer address; see deployment/nginx.conf.
CMD ["python", "-m", "uvicorn", "api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
