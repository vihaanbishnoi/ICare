# Non-secret supported environment settings. Set them in your shell/host.
# Python does not automatically load this file.
ICARE_POSEC3D_MODEL=models/posec3d_fall.onnx
ICARE_POSE_MODEL=models/yolo26n-pose.onnx
ICARE_POSE_DEVICE=cpu
# ICARE_INFERENCE_WIDTH is read by icare.inference.engine; model/device by icare.api.engine.
ICARE_INFERENCE_WIDTH=416
ICARE_API_DATA_DIR=artifacts/api
ICARE_MAX_UPLOAD_MB=50
ICARE_MAX_UPLOAD_SECONDS=60
ICARE_MAX_QUEUED_JOBS=5
ICARE_JOB_TIMEOUT_SECONDS=600
ICARE_RETENTION_HOURS=24
ICARE_CLEANUP_INTERVAL_SECONDS=60
# 0 for local HTTP. A trusted HTTPS production proxy requires 1.
ICARE_COOKIE_SECURE=0
# Optional explicit trusted browser origins; same-origin works without this.
ICARE_ALLOWED_ORIGINS=
# Optional Vite development backend target (default below).
ICARE_API_TARGET=http://127.0.0.1:8000

# Admission defaults; tune against measured host capacity.
ICARE_MAX_ACTIVE_JOBS_PER_VISITOR=2
ICARE_MAX_JOBS_PER_VISITOR_WINDOW=12
ICARE_MAX_JOBS_PER_IP_WINDOW=60
ICARE_ADMISSION_WINDOW_SECONDS=3600
ICARE_MAX_STORAGE_MB=1024

# Per person: consecutive P(Fall) >= 0.50 predictions before an incident (1 = baseline).
ICARE_FALL_CONFIRMATIONS=1
# Result/report storage per job; grows with the number of people tracked.
ICARE_RESULT_BUDGET_MB=16

# Fall clips: own storage cap (oldest clips evicted first) and expiry.
ICARE_MAX_CLIP_STORAGE_MB=1024
ICARE_CLIP_RETENTION_HOURS=24
# Clip window around the detection timestamp: pre + post = the ~4 s clip.
ICARE_CLIP_PRE_SECONDS=3
ICARE_CLIP_POST_SECONDS=1
ICARE_MAX_CLIPS_PER_JOB=10
